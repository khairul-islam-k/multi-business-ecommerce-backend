// ======================================================
// ENUMS
// ======================================================

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum InventoryMovementType {
  PURCHASE_IN
  PURCHASE_RETURN_OUT
  SALE_OUT
  SALE_RETURN_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  RESERVED
  RESERVATION_RELEASED
}

enum InventoryReferenceType {
  PURCHASE_ORDER
  SUPPLIER_INVOICE
  PURCHASE_RETURN
  ORDER
  ORDER_RETURN
  STOCK_ADJUSTMENT
  STOCK_TRANSFER
  MANUAL
}

enum InventoryAdjustmentType {
  INCREASE
  DECREASE
}

enum InventoryAdjustmentStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum InventoryTransferStatus {
  DRAFT
  PENDING
  APPROVED
  SHIPPED
  RECEIVED
  CANCELLED
}

enum InventoryOrderAllocationStatus {
  RESERVED
  FULFILLED
  RELEASED
}

// ======================================================
// Models
// ======================================================

model Warehouse {
  id         String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid

  name    String          @db.VarChar(150)
  phone   String?         @db.VarChar(30)
  address String?
  status  WarehouseStatus @default(ACTIVE)

  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  stocks      InventoryWarehouseStock[]
  movements   InventoryStockMovement[]
  adjustments InventoryStockAdjustment[]
  allocations InventoryOrderAllocation[]

  transfersFrom InventoryStockTransfer[] @relation("TransferFromWarehouse")
  transfersTo   InventoryStockTransfer[] @relation("TransferToWarehouse")

  @@unique([businessId, name])
  @@index([businessId])
  @@index([status])
  @@index([deletedAt])
  @@map("inventory_warehouses")
}

model InventoryStock {
  id         String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  variantId  String? @map("variant_id") @db.Uuid
  stockItemKey String @map("stock_item_key") @db.VarChar(80)

  totalQuantity    Decimal @default(0) @map("total_quantity") @db.Decimal(14, 3)
  quantityReserved Decimal @default(0) @map("quantity_reserved") @db.Decimal(14, 3)
  lowStockAlertQty Decimal @default(0) @map("low_stock_alert_qty") @db.Decimal(14, 3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product       Product               @relation("StockProduct", fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant?       @relation("StockVariant", fields: [variantId], references: [id], onDelete: SetNull)

  warehouseStocks InventoryWarehouseStock[]
  movements       InventoryStockMovement[]
  allocations     InventoryOrderAllocation[]

  @@unique([businessId, stockItemKey])
  @@index([businessId])
  @@index([productId])
  @@index([variantId])
  @@map("inventory_stocks")
}

model InventoryWarehouseStock {
  id          String @id @default(uuid()) @db.Uuid
  businessId  String @map("business_id") @db.Uuid
  stockId     String @map("stock_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid
  variantId   String? @map("variant_id") @db.Uuid
  stockItemKey String @map("stock_item_key") @db.VarChar(80)

  totalQuantity    Decimal @default(0) @map("total_quantity") @db.Decimal(14, 3)
  quantityReserved Decimal @default(0) @map("quantity_reserved") @db.Decimal(14, 3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stock     InventoryStock @relation(fields: [stockId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([businessId, warehouseId, stockId], map: "inventory_wh_stock_by_stock_unique")
  @@unique([businessId, warehouseId, stockItemKey], map: "inventory_wh_stock_by_item_unique")
  @@index([businessId])
  @@index([stockId])
  @@index([warehouseId])
  @@index([productId])
  @@index([variantId])
  @@map("inventory_warehouse_stocks")
}

model InventoryStockMovement {
  id          String @id @default(uuid()) @db.Uuid
  businessId  String @map("business_id") @db.Uuid
  stockId     String @map("stock_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid
  variantId   String? @map("variant_id") @db.Uuid
  stockItemKey String @map("stock_item_key") @db.VarChar(80)

  movementType InventoryMovementType @map("movement_type")
  quantity     Decimal               @db.Decimal(14, 3)

  referenceType InventoryReferenceType? @map("reference_type")
  referenceId   String?                 @map("reference_id") @db.Uuid

  note      String?
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  stock     InventoryStock @relation(fields: [stockId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product Product @relation("StockMovementProduct", fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation("StockMovementVariant", fields: [variantId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([stockId])
  @@index([warehouseId])
  @@index([productId])
  @@index([variantId])
  @@index([stockItemKey])
  @@index([movementType])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("inventory_stock_movements")
}

model InventoryOrderAllocation {
  id          String @id @default(uuid()) @db.Uuid
  businessId  String @map("business_id") @db.Uuid
  orderId     String @map("order_id") @db.Uuid
  orderItemId String @map("order_item_id") @db.Uuid
  stockId     String @map("stock_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid
  variantId   String? @map("variant_id") @db.Uuid
  stockItemKey String @map("stock_item_key") @db.VarChar(80)

  quantity Decimal                        @db.Decimal(14, 3)
  status   InventoryOrderAllocationStatus @default(RESERVED)

  createdBy   String?   @map("created_by") @db.Uuid
  fulfilledAt DateTime? @map("fulfilled_at")
  releasedAt  DateTime? @map("released_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  stock     InventoryStock @relation(fields: [stockId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([stockId])
  @@index([warehouseId])
  @@index([productId])
  @@index([variantId])
  @@index([stockItemKey])
  @@index([status])
  @@map("inventory_order_allocations")
}

model InventoryStockAdjustment {
  id          String @id @default(uuid()) @db.Uuid
  businessId  String @map("business_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid

  adjustmentNo   String                    @map("adjustment_no") @db.VarChar(100)
  adjustmentType InventoryAdjustmentType   @map("adjustment_type")
  reason         String?
  status         InventoryAdjustmentStatus @default(DRAFT)

  createdBy  String?   @map("created_by") @db.Uuid
  approvedBy String?   @map("approved_by") @db.Uuid
  approvedAt DateTime? @map("approved_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  warehouse Warehouse                      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  items     InventoryStockAdjustmentItem[]

  @@unique([businessId, adjustmentNo])
  @@index([businessId])
  @@index([warehouseId])
  @@index([adjustmentType])
  @@index([status])
  @@map("inventory_stock_adjustments")
}

model InventoryStockAdjustmentItem {
  id           String @id @default(uuid()) @db.Uuid
  adjustmentId String @map("adjustment_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  variantId    String? @map("variant_id") @db.Uuid

  oldQuantity   Decimal @map("old_quantity") @db.Decimal(14, 3)
  adjustmentQty Decimal @map("adjustment_qty") @db.Decimal(14, 3)
  reason        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  adjustment InventoryStockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)

  @@index([adjustmentId])
  @@index([productId])
  @@index([variantId])
  @@map("inventory_stock_adjustment_items")
}

model InventoryStockTransfer {
  id         String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid

  transferNo      String @map("transfer_no") @db.VarChar(100)
  fromWarehouseId String @map("from_warehouse_id") @db.Uuid
  toWarehouseId   String @map("to_warehouse_id") @db.Uuid

  status InventoryTransferStatus @default(DRAFT)
  note   String?

  createdBy  String? @map("created_by") @db.Uuid
  approvedBy String? @map("approved_by") @db.Uuid

  shippedAt  DateTime? @map("shipped_at")
  receivedAt DateTime? @map("received_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  fromWarehouse Warehouse @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)

  items InventoryStockTransferItem[]

  @@unique([businessId, transferNo])
  @@index([businessId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([status])
  @@map("inventory_stock_transfers")
}

model InventoryStockTransferItem {
  id         String @id @default(uuid()) @db.Uuid
  transferId String @map("transfer_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  variantId  String? @map("variant_id") @db.Uuid

  requestedQuantity   Decimal @default(0) @map("requested_quantity") @db.Decimal(14, 3)
  transferredQuantity Decimal @default(0) @map("transferred_quantity") @db.Decimal(14, 3)
  receivedQuantity    Decimal @default(0) @map("received_quantity") @db.Decimal(14, 3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transfer InventoryStockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([productId])
  @@index([variantId])
  @@map("inventory_stock_transfer_items")
}
