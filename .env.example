APP_NAME="Onecomm"
APP_PORT="8080"
APP_IP="localhost"
APP_CORS_ORIGINS="http://localhost:3000"
APP_CORS_SUBDOMAIN_BASES="localhost"

DATABASE_URL="postgresql://onecomm:onecomm@localhost:5432/onecomm"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_IN_DAYS="30"

SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@example.test"
SEED_ADMIN_PASSWORD="change-me-admin-password"

MEDIA_UPLOAD_ROOT="uploads"
PUBLIC_UPLOAD_PREFIX="/uploads"

MEDIA_MAX_IMAGE_SIZE_BYTES="5242880"
MEDIA_MAX_BULK_IMAGE_FILES="20"
MEDIA_MAX_BULK_DELETE_IMAGES="100"

MAIL_PASS="change-me-mail-password"
MAIL_HOST="smtp.example.test"
MAIL_PORT="587"
MAIL_USER="smtp-user"
MAIL_FROM="noreply@example.test"

OTP_SECRET="change-me-otp-secret"
OTP_MAX_ATTEMPT="5"
OTP_EXPIRES_IN_MINS="10"

PAYMENT_CONFIG_ENCRYPTION_KEY="change-me-payment-config-encryption-key"
