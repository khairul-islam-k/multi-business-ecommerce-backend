{
  "name": "onecomm-api",
  "version": "0.0.1",
  "description": "",
  "author": "Utsho MH",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "bunx --bun prisma generate && nest start --watch --exec bun",
    "dev:direct": "bunx --bun prisma generate && bun --watch ./src/main.ts",
    "build": "bunx --bun prisma generate && nest build",
    "start": "nest start --exec bun",
    "start:dev": "nest start --watch --exec bun",
    "start:debug": "nest start --debug --watch --exec bun",
    "start:prod": "bun dist/src/main.js",
    "db:migrate:dev": "bunx --bun prisma migrate dev",
    "db:migrate:prod": "bunx --bun prisma migrate deploy",
    "db:push": "bunx --bun prisma db push",
    "db:generate": "bunx --bun prisma generate",
    "db:seed-admin": "bun scripts/seed-admin.ts",
    "db:reset-data": "bun scripts/reset-db.ts",
    "db:studio": "bunx --bun prisma studio",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "check": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.26",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.26",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.26",
    "@nestjs/swagger": "^11.4.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nodemailer": "^8.0.11",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.26",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.2",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.4",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
