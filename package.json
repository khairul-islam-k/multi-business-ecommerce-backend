{
  "name": "onecomm-api",
  "version": "0.0.1",
  "description": "",
  "author": "Utsho MH",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "compile": "bun build ./src/main.ts --compile --minify --outfile ./bin/onecomm-api --external @nestjs/microservices --external @nestjs/microservices/microservices-module --external @nestjs/websockets/socket-module --external class-transformer/storage",
    "execute": "./bin/onecomm-api",
    "execute:all": "concurrently \"bun run execute\" \"bun run db:studio\"",
    "build": "nest build",
    "start": "nest start --exec bun",
    "start:dev": "nest start --watch --exec bun",
    "start:debug": "nest start --debug --watch --exec bun",
    "start:prod": "bun dist/src/main.js",
    "db:push": "bunx --bun drizzle-kit push",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate:dev": "bunx --bun drizzle-kit generate",
    "db:migrate:prod": "bunx --bun drizzle-kit migrate",
    "db:seed:admin": "bun scripts/seed-admin.ts",
    "db:seed:payment-gateways": "bun scripts/seed-payment-gateways.ts",
    "db:seed:package-payment-config": "bun scripts/seed-package-payment-config.ts",
    "db:seed:couriers": "bun scripts/seed-couriers.ts",
    "db:seed:all": "bun run db:seed:admin && bun run db:seed:payment-gateways && bun run db:seed:couriers && bun run db:seed:package-payment-config",
    "db:reset": "bun scripts/reset-db.ts",
    "db:drop": "bun scripts/drop-db.ts",
    "db:studio": "bunx --bun drizzle-kit studio",
    "db:check": "bunx --bun drizzle-kit check",
    "typecheck": "bunx tsc --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest --runTestsByPath test/integration --passWithNoTests",
    "check": "bun run typecheck && bun run test",
    "dev": "bun --watch ./src/main.ts",
    "dev:all": "concurrently \"bun run dev\" \"bun run db:studio\""
  },
  "dependencies": {
    "@nestjs/common": "^11.1.26",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.26",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.26",
    "@nestjs/swagger": "^11.4.4",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "nodemailer": "^8.0.11",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.26",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.2",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.4",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
